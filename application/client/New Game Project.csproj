<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>NewGameProject</RootNamespace>
    <!-- Rust integration properties -->
    <RuntimeDllName>libxml_xsd2.dll</RuntimeDllName>
    <RustManifest>$(MSBuildProjectDirectory)\..\runtime\Cargo.toml</RustManifest>
    <RustBuildProfile>release</RustBuildProfile>
    <RustDllPath>$(MSBuildProjectDirectory)\..\runtime\target\$(RustBuildProfile)\$(RuntimeDllName)</RustDllPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageReference Include="Xunit.Gherkin.Quick" Version="4.5.0" />
    <None Update="Features\**\*.feature">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="RiderTestRunner\NetCoreRunner.tscn" />
  </ItemGroup>

  <!-- Build Rust runtime and copy DLL into the client folder before building C# assemblies -->
  <Target Name="BuildRustRuntime" BeforeTargets="BeforeBuild">
    <Message Text="Building Rust runtime (cargo)..." Importance="high" />
    <Exec Command="cargo build --manifest-path &quot;$(RustManifest)&quot; --$(RustBuildProfile)" />
    <Message Text="Copying Rust runtime DLL to client folder..." Importance="high" />
    <ItemGroup>
      <RustBuiltDll Include="$(RustDllPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(RustBuiltDll)" DestinationFolder="$(MSBuildProjectDirectory)" SkipUnchangedFiles="true" />
  </Target>
</Project>