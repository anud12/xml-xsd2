{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "moduleResolution": "Node",
    "typeRoots": ["./types"]
  },
  "include": [
    "../../suite/types/**/*.d.ts",
    "./**/*.js",
    "Modules/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "Modules/*/dist"
  ]
}
