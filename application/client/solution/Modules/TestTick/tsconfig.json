{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Node",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": false,
    "noEmitOnError": false
  },
  "include": [
    "./src/**/*.ts",
    "../../../../suite/types/**/*.d.ts"
  ]
}
