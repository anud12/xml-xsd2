{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Node",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": false,
    "noEmitOnError": false,
    "outDir": "../TestTick",
    "rootDir": "./src"
  },
  "include": [
    "./src/**/*.ts",
    "../../../../module_types/**/*.d.ts",
    "../../../../ui/types/**/*.d.ts"
  ]
}
