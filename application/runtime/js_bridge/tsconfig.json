{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "noEmit": true,
    "checkJs": false,
    "esModuleInterop": true,
    "baseUrl": "..",
    "paths": {
      "module-public-api/*": ["../module-public-api/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../module-public-api/types/**/*.d.ts",
    "../../module-public-api/types/**/*.ts"
  ]
}
